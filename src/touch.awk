# touch.awk: touchgestured's settings and the gesture keyboard's key layout from tp: assignments.
#   awk -v kl=KL_OUT -f touch.awk STMPE_KL TP_CONFIG > touchgestured.conf
# TP_CONFIG holds the tp: assignments other than tp:mode, one ID=VALUE per line without "tp:", as
# remap.sh checked them. STMPE_KL is the keyboard's key layout in effect; its modifier keys become
# the "mod" lines. Each assignment is also kept as a "# KEY2_TP" line for remap.sh read.
#
# Each gesture of each layer has a fixed scan code on the gesture keyboard, so no table of codes
# has to be stored: number i = layer * 39 + (fingers - 1) * 13 + the gesture's position in
# touchgestured's list (config.h), code 0x200 + i, or 0x2e8 + (i - 192) for the last three so that
# every code stays under KEY_MAX (0x2ff) and clear of the gamepad range BTN_TRIGGER_HAPPY
# (0x2c0-0x2e7).
BEGIN {
    n = split("swipe_up swipe_down swipe_left swipe_right flick_up flick_down flick_left flick_right " \
              "flick_upleft flick_upright flick_downleft flick_downright tap", g, " ")
    split("swipe up,swipe down,swipe left,swipe right,flick up,flick down,flick left,flick right," \
          "flick up-left,flick up-right,flick down-left,flick down-right,tap", name, ",")
    for (i = 1; i <= n; i++) { index_of[g[i]] = i - 1; conf_name[g[i]] = name[i] }
    split("shift alt ctrl sym", l, " ")
    for (i = 1; i <= 4; i++) layer_of[l[i]] = i
    split("start_mm step_mm flick_mm_s tap_ms hold_ms gather_ms after_key_ms", t, " ")
    for (i in t) threshold[t[i]] = 1
    print "# Generated by remap.sh from the tp: assignments."
    print "# touchgestured's modifier keys." > kl
    print "key 29 CTRL_LEFT" > kl
    print "key 42 SHIFT_LEFT" > kl
    print "key 56 ALT_LEFT" > kl
    print "key 125 META_LEFT" > kl
    print "# Gesture keys." > kl
}

{ sub(/\r$/, "") }

FNR == NR {
    if ($1 == "key" && $2 ~ /^[0-9]+$/ && !($2 in mod_of)) {
        if ($3 ~ /^SHIFT_/) mod_of[$2] = "shift"
        else if ($3 ~ /^CTRL_/) mod_of[$2] = "ctrl"
        else if ($3 ~ /^ALT_/) mod_of[$2] = "alt"
        else if ($3 ~ /^META_/) mod_of[$2] = "meta"
        else if ($3 == "SYM") mod_of[$2] = "sym"
        if ($2 in mod_of) mods[++nmods] = $2
    }
    next
}

{
    eq = index($0, "=")
    id = substr($0, 1, eq - 1); value = substr($0, eq + 1)
    print "# KEY2_TP " $0
    if (id in threshold) {
        print id " " value
    } else if (id ~ /^[123]_pass$/) {
        print "pass " substr(id, 1, 1)
    } else {
        layer = 0
        if (match(id, /^[a-z]+_/) && (substr(id, 1, RLENGTH - 1) in layer_of)) {
            layer_name = substr(id, 1, RLENGTH - 1); layer = layer_of[layer_name]; id = substr(id, RLENGTH + 1)
        }
        fingers = substr(id, 1, 1); gesture = substr(id, 3)
        parts = split(value, p, "+")
        once = p[parts] == "once"
        if (once) parts--
        modifiers = ""
        for (i = 2; i <= parts; i++) modifiers = modifiers (i > 2 ? "+" : "") p[i]
        i = layer * 39 + (fingers - 1) * 13 + index_of[gesture]
        code = i < 192 ? 512 + i : 744 + i - 192
        print "bind " (layer ? layer_name " " : "") fingers " " conf_name[gesture] " key " code \
            (modifiers != "" ? " " modifiers : "") (once ? " once" : "")
        print "key " code " " p[1] > kl
    }
}

END {
    for (i = 1; i <= nmods; i++) print "mod " mods[i] " " mod_of[mods[i]]
}
