# KEY2-shaped character map for tests. Written for this project; not a device file.

# Values are arbitrary. Keys, rule shapes and escapes follow the device map.

type ALPHA

### Row 1

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    alt, lalt:                          '1'
    sym: replace ESCAPE
}

key W {
    label:                              'W'
    base:                               'w'
    shift, capslock:                    'W'
    alt, lalt:                          '2'
    sym: replace TAB
}

key E {
    label:                              'E'
    base:                               'e'
    shift, capslock:                    'E'
    alt, lalt:                          '3'
    sym:                                '\u00E9'
}

key R {
    label:                              'R'
    base:                               'r'
    shift, capslock:                    'R'
    alt, lalt:                          '4'
    sym:                                '\u00AE'
}

key T {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
    alt, lalt:                          '5'
    sym:                                '{'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    alt, lalt:                          '6'
    sym:                                '}'
}

key U {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
    alt, lalt:                          '7'
    sym: replace MOVE_HOME
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    alt, lalt:                          '8'
    sym: replace INSERT
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    alt, lalt:                          '9'
    sym: replace MOVE_END
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    alt, lalt:                          '0'
    sym:                                '%'
}

### Row 2

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    alt, lalt:                          '-'
    sym:                                '\u00E4'
}

key S {
    label:                              'S'
    base:                               's'
    shift, capslock:                    'S'
    alt, lalt:                          '+'
    sym:                                '\u00DF'
}

key D {
    label:                              'D'
    base:                               'd'
    shift, capslock:                    'D'
    alt, lalt:                          '='
    sym:                                '\u00B0'
}

key F {
    label:                              'F'
    base:                               'f'
    shift, capslock:                    'F'
    alt, lalt:                          '('
    sym:                                '\u00A7'
}

key G {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
    alt, lalt:                          ')'
    sym:                                '\\'
}

key H {
    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
    alt, lalt:                          '/'
    sym: replace DPAD_LEFT
}

key J {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
    alt, lalt:                          ';'
    sym: replace DPAD_DOWN
}

key K {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
    alt, lalt:                          '\''
    sym: replace DPAD_UP
}

key L {
    label:                              'L'
    base:                               'l'
    shift, capslock:                    'L'
    alt, lalt:                          '\"'
    sym: replace DPAD_RIGHT
}

### Row 3

key Z {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
    alt, lalt:                          '<'
    sym:                                '\u00A2'
}

key X {
    label:                              'X'
    base:                               'x'
    shift, capslock:                    'X'
    alt, lalt:                          '>'
    sym:                                '\u00D7'
}

key C {
    label:                              'C'
    base:                               'c'
    shift, capslock:                    'C'
    alt, lalt:                          '['
    sym:                                '\u00A9'
}

key V {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
    alt, lalt:                          ']'
    sym:                                '\u00B6'
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    alt, lalt:                          '?'
    sym:                                '\u2026'
}

key N {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
    alt, lalt:                          ','
    sym: replace PAGE_DOWN
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    alt, lalt:                          '.'
    sym: replace PAGE_UP
}

key 4 {
    label:                              '$'
    base, capslock:                     '$'
    shift:                              '\u00A3' # pound sign
    alt, lalt:                          '$'
    sym:                                '\u00A2'
    lalt+lshift:                        '\uE141' # private-use character of the microphone key
}

### Row 4

key 0 {
    label:                              '0'
    base:                               '0'
    shift, capslock:                    '0'
    alt, lalt:                          '0'
}

key SPACE {
    label:                              ' '
    base, shift, capslock, alt, lalt:   ' '
}

key ENTER {
    label:                              '\n'
    base:                               '\n'
}
# KEY2_GUI H=DPAD_LEFT
# KEY2_GUI I=INSERT
# KEY2_GUI J=DPAD_DOWN
# KEY2_GUI K=DPAD_UP
# KEY2_GUI L=DPAD_RIGHT
# KEY2_GUI M=PAGE_UP
# KEY2_GUI N=PAGE_DOWN
# KEY2_GUI O=MOVE_END
# KEY2_GUI Q=ESCAPE
# KEY2_GUI U=MOVE_HOME
# KEY2_GUI W=TAB
